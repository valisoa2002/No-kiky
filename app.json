{
  "expo": {
    "name": "No-kiky",
    "slug": "no-kiky",
    "scheme": "nokiky",
    "version": "0.3.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "icon": "./assets/no-kiky-icon.png",
    "android": {
      "package": "mg.nokiky.app",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.INTERNET"
      ],
      "versionCode": 3
    },

    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "Autoriser No-kiky à scanner les cartes",
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-mlkit-ocr",
        {
          "iosEngine": "auto"
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "enableMinifyInReleaseBuilds": false,
            "enableShrinkResourcesInReleaseBuilds": false
          }
        }
      ]
    ],

    "extra": {
      "eas": {
        "projectId": "37210cee-ba87-4650-bfb0-a73079f855c3"
      }
    }
  }
}
